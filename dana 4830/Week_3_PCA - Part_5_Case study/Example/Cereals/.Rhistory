# define a variable
Whiskey <- c(FALSE, TRUE, TRUE)
# define a variable
Vodka <- c(FALSE, TRUE, TRUE)
# combine all variables as matrix object
x <- rbind(Wine,Beer, Whiskey, Vodka)
x
dist(x, method="binary")
