PCA1standardization <- read.csv("~/Desktop/Langara/DANA4830/2022_Topics/Week_2_PCA - Part_3_Standardisation_ExtractComponents/Lecture/PCA1standardization.csv")
View(PCA1standardization)
df <- PCA1standardization
#slide7
df.pca <- prcomp(df)
#rotation
varimax.one <- varimax(df.pca$loadings)
#slide15
library(factoextra)
#rotation
varimax.one <- varimax(df.pca$loadings)
##principal fun from psych
#loadings in psych are not unit eigenvectors because it uses them for factor rotation
library(psych)
pca_fit <- principal(df, nfactors = 2, rotate = "none")
pca_fit$loadings
pca_rot <- principal(r = df, rotate = "varimax", nfactors = 5)
pca_rot <- principal(r = df, rotate = "varimax", nfactors = 2)
pca_rot$loadings
Varimax<-princomp(df, rotation="varimax")
