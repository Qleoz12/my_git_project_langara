#load various library
library(datasets)
library(cluster)  # necessary for PAM, CLARA, Silhouette
library(ggplot2)
library(factoextra)
#load iris dataset
data(iris)
#create plot
ggplot(iris, aes(Petal.Length, Petal.Width, color = Species)) + geom_point()
#set.seed(5809) for reproducibility purposes
set.seed(5809)
# use kmean function with the following requirements
# nstart = 20 means that R will try 20 different random starting
# assignments and then select the one with the lowest within cluster variation.
# the interested variables are Petal.Length, Petal.Width for computing
irisCluster <- kmeans(iris[,3:4], 3, nstart = 20)
irisCluster
#use the output $cluster and compare it with species
table(irisCluster$cluster, iris$Species)
#Question: should we use Elbow method or Silhouette method to evaluate the number of clusters
# #visualise the clustering outcome by using scatter plot with $cluster to differentiate 3 species
irisCluster$cluster <- as.factor(irisCluster$cluster)
ggplot(iris, aes(Petal.Length, Petal.Width, color = irisCluster$cluster)) + geom_point()
View(iris)
#Use USArrest dataset to demonstrate distance
data("USArrests")
#standardized variables
df.scaled <- scale(USArrests)   # Standardize the variables
#calculate euclidean distance
dist.eucl <- dist(df.scaled, method = "euclidean")
#calculate euclidean distance
dist.eucl <- dist(df.scaled, method = "euclidean")
# Reformat as a matrix
# Subset the first 3 columns and rows and Round the values
round(as.matrix(dist.eucl)[1:3, 1:3], 1)
#calculate manhantance distance
dist.mah <- dist(df.scaled, method = "manhattan")
# Reformat as a matrix
# Subset the first 3 columns and rows and Round the values
round(as.matrix(dist.mah)[1:3, 1:3], 1)
#calculate canberra distance
dist.can <- dist(df.scaled, method = "canberra")
# Reformat as a matrix
# Subset the first 3 columns and rows and Round the values
round(as.matrix(dist.can)[1:3, 1:3], 1)
library("factoextra")
dist.cor <- get_dist(df.scaled, method = "pearson")
# Display a subset
round(as.matrix(dist.cor)[1:3, 1:3], 1)
#####mixed data
library(cluster)
head(flower, 3)
# Distance matrix using daisy function using Gower measure
# in this function manhattan distance is used for continous data
# in this function dice distance to calculate distance for binary/non binary
# in this function, ordinal data is converted to the rank to simpe ranks and use
# and use manhanttan to calculate distance between rows
dd <- daisy(flower)
round(as.matrix(dd)[1:3, 1:3], 2)
#visualize distance
#Red: high similarity (ie: low dissimilarity)
#Blue: low similarity
library(factoextra)
fviz_dist(dist.eucl)
fviz_dist(dist.cor)
fviz_dist(dist.can)
#binary data using Jaccard
# define a variable
Wine <- c(TRUE, FALSE, FALSE)
# define a variable
